  <upgrade for="2.1.7-2.1.8" from="0.1.0-dev1,0.1.0-dev2,0.1.0-dev3,0.1.0-dev4,0.1.0-dev5,0.1.0-dev6,0.1.0-dev7,0.1.0-dev8,0.1.0-dev9,0.1.0-dev10">
